 RowBox[{
  RowBox[{"VsotaKvadratov", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"x", "^", "2"}], "+", 
   RowBox[{"y", "^", "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
