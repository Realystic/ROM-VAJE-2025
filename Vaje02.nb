Cell[CellGroupData[{

Cell["Naloga 10", "Section",
 CellChangeTimes->{{3.9187370852716913`*^9, 
  3.918737094782496*^9}},ExpressionUUID->"7a3fecdb-0f88-405d-a87c-\
818764bd38a0"],

Cell["\<\
Napi\[SHacek]i funkcijo, ki sprejme narvni \[SHacek]tevili m in n in vrne \
seznam prvih n \[CHacek]lenov Collatzovega zaporedja za \[SHacek]tevilo m. \
Pomagaj si s funkcijo \[OpenCurlyDoubleQuote]RecurrenceTable\
\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{
  3.918737113432963*^9, {3.918737191383535*^9, 3.9187373076375113`*^9}, {
   3.918738735534246*^9, 3.918738861279017*^9}, {3.9187389633345213`*^9, 
   3.918738969546136*^9}, {3.918739007050296*^9, 3.9187390134649553`*^9}, {
   3.918739651116387*^9, 
   3.918739676738667*^9}},ExpressionUUID->"6be2cca8-669f-4066-8e53-\
f03f5cd8267f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Collatz", "[", 
   RowBox[{"m_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"RecurrenceTable", "[", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", 
        RowBox[{"k", " ", "+", " ", "1"}], "]"}], " ", "==", " ", 
       RowBox[{"If", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"a", "[", "k", "]"}], ",", " ", "2"}], "]"}], " ", "==", 
          " ", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"a", "[", "k", "]"}], "/", "2"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"3", "*", 
           RowBox[{"a", "[", "k", "]"}]}], "+", "1"}]}], 
        "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "[", "1", "]"}], " ", "==", " ", "m"}]}], "}"}], 
    "\[IndentingNewLine]", ",", "a", ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9496521609868755`*^9, 3.9496521809822674`*^9}, {
   3.949652293870983*^9, 3.949652318340515*^9}, {3.9496523541729736`*^9, 
   3.949652470060068*^9}, {3.9496525355097065`*^9, 3.949652540829033*^9}, {
   3.9496525744957447`*^9, 3.949652578858902*^9}, {3.949652666152811*^9, 
   3.94965267151688*^9}, {3.949652773050894*^9, 3.949652775615448*^9}, {
   3.949652881473194*^9, 3.949652908584814*^9}, {3.949652941836231*^9, 
   3.9496529707875366`*^9}, {3.949653032941633*^9, 3.949653096200054*^9}, {
   3.9496531306464043`*^9, 3.9496532218502636`*^9}, {3.949653259875452*^9, 
   3.9496532745535336`*^9}, 3.949653311775093*^9, {3.949653391571743*^9, 
   3.9496533926811924`*^9}},
 CellLabel->
  "In[159]:=",ExpressionUUID->"eb0aee8b-6027-1f4f-b54d-c9eb8e66310e"],

