Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"x", "^", "3"}], "+", 
    RowBox[{"y", "^", "3"}], "-", 
    RowBox[{"3", "x", "*", "y"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.952668659662958*^9, 3.9526686835191097`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"7a1ae611-c1ed-c24d-a24c-dd54db39f28a"],

Cell["\<\
b) Izra\[CHacek]unajte gradient funkcije (par, kjer je na prvem mestu odvod \
funkcije po x in na drugem mestu odvod funkcije po y). Kdaj je gradient enak \
0?\
\>", "Text",
 CellChangeTimes->{{3.95265831047186*^9, 3.952658355500422*^9}, {
  3.9526584155835657`*^9, 
  3.95265842254725*^9}},ExpressionUUID->"a3a12d39-a0c0-406f-a2b3-\
634c8599993e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gradient", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], ",", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", " ", "y"}], "]"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.952668719337126*^9, 3.952668821794611*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"8ff99062-ba47-8a40-befe-2b875d2fae13"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{"3", " ", "y"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "3"}], " ", "x"}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["y", "2"]}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9526687724530926`*^9, {3.95266880508016*^9, 3.952668822201086*^9}},
 CellLabel->"Out[6]=",ExpressionUUID->"17a4cabd-ac54-ca42-8b2b-97a990294644"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gradient1", " ", "=", " ", 
