Cell[CellGroupData[{

Cell["2. Naloga", "Section",
 CellChangeTimes->{{3.952658686783333*^9, 
  3.952658688810295*^9}},ExpressionUUID->"e46c2761-ac13-4bbe-bd5d-\
ccc04e24d65e"],

Cell[TextData[{
 "Dana je ena\[CHacek]ba ploskve ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["y", "TI"], "2"], "-", 
         SuperscriptBox[
          StyleBox["z", "TI"], "3"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x^2+y^2-z^3=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a6ee087-16b6-4946-9e3f-008e2a625f69"],
 "."
}], "Text",
 CellChangeTimes->{{3.952658747254744*^9, 
  3.952658803779004*^9}},ExpressionUUID->"73525f9b-87a9-41ca-adbe-\
e87cee0a8bfc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ploskev", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "^", "2"}], "+", 
     RowBox[{"y", "^", "2"}], "-", 
     RowBox[{"z", "^", "3"}]}], "==", "1"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.952671534044285*^9, 3.9526715685765896`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"d5835247-511f-494b-adcc-4968aac16fdc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "2"], "-", 
    SuperscriptBox["z", "3"]}], "\[Equal]", "1"}], "}"}]], "Output",
 CellChangeTimes->{{3.9526715627433224`*^9, 3.9526715689214687`*^9}},
 CellLabel->"Out[25]=",ExpressionUUID->"b80d71bc-8f96-3247-9d97-11edfbef13e2"]
}, Open  ]],

Cell["a) Poi\[SHacek]\[CHacek]ite prece\[CHacek]i\[SHacek]\[CHacek]a te \
ploskve s koordinatnimi ravninami.", "Text",
 CellChangeTimes->{{3.9526588057043123`*^9, 
  3.9526588316962357`*^9}},ExpressionUUID->"c986ba4b-8898-4093-835e-\
26b30f6ffe4a"],

Cell["b) Nari\[SHacek]ite ploskev v 3D.", "Text",
 CellChangeTimes->{{3.9526588344116983`*^9, 
  3.952658854192623*^9}},ExpressionUUID->"b18c7f28-3772-4841-a276-\
49dcdf465bb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Naloga", "Section",
 CellChangeTimes->{{3.952658872887321*^9, 
  3.952658874670026*^9}},ExpressionUUID->"03211965-fe56-4593-9b4f-\
bd96f7fa66b2"],

Cell[TextData[{
 "Dana je funkcija ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["x", "TI"]], "*", "cos", 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["x", "TI"], "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "f(x) = e^x*\\cos(x^3)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dae4cd6f-0543-4029-8d6d-3efeede75f37"],
 "."
}], "Text",
 CellChangeTimes->{{3.952658880539879*^9, 3.95265889528627*^9}, 
   3.952658999147184*^9},ExpressionUUID->"e5e4d380-22a9-4834-ae40-\
9b72ae66391c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"E", "^", "x"}], "*", 
   RowBox[{"Cos", "[", 
    RowBox[{"x", "^", "3"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.952671676216343*^9, 3.952671690977333*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"41267a76-914c-ab49-bb84-df85238d3205"],

Cell["\<\
a) Razvijte funkcijo v Taylorjev polinom stopnje 6 okoli to\[CHacek]ke 0.\
\>", "Text",
 CellChangeTimes->{{3.952659005272785*^9, 
  3.952659034057413*^9}},ExpressionUUID->"7fd42c72-c7fc-4a10-a7e3-\
ce904c48e4de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"polinom", "=", 
  RowBox[{"Normal", "[", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9526716971611996`*^9, 3.952671726430195*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"6313a618-5ad7-0142-b11f-3fb4fa593a84"],

Cell[BoxData[
 RowBox[{"1", "+", "x", "+", 
  FractionBox[
   SuperscriptBox["x", "2"], "2"], "+", 
  FractionBox[
   SuperscriptBox["x", "3"], "6"], "+", 
  FractionBox[
   SuperscriptBox["x", "4"], "24"], "+", 
  FractionBox[
   SuperscriptBox["x", "5"], "120"], "-", 
  FractionBox[
   RowBox[{"359", " ", 
    SuperscriptBox["x", "6"]}], "720"]}]], "Output",
 CellChangeTimes->{3.9526717277453766`*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"13ae4f83-c5c8-1347-9357-308485bd0509"]
}, Open  ]],

Cell["\<\
b) Nari\[SHacek]ite originalno funkcijo in njeno aproksimacijo na intervalu \
[-2, 2].\
\>", "Text",
 CellChangeTimes->{{3.952659036664928*^9, 
  3.9526590814867687`*^9}},ExpressionUUID->"aa037729-4f22-49cc-9979-\
3f84c9f5e145"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", "polinom"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]], "Input",
