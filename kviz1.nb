bd857b7c1d6b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prepisc", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "^", "n_"}], " ", "->", 
     RowBox[{"Divide", "[", 
      RowBox[{
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"n", "+", "1"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"2", "n"}], "+", "1"}]}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.952068553922365*^9, 3.9520686205462074`*^9}, {
   3.952068841849468*^9, 3.952068848483404*^9}, 3.9520688838449993`*^9, 
