Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox["x", "n"], "\[Rule]", 
   FractionBox[
    SuperscriptBox["x", 
     RowBox[{"1", "+", "n"}]], 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", "n"}]}]]}], "}"}]], "Output",
