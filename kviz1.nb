Cell[CellGroupData[{
Cell["1. kviz - Ra\[CHacek]unalni\[SHacek]ka orodja v matematiki", "Title",
 CellChangeTimes->{{3.951136784917365*^9, 3.951136799365633*^9}, {
  3.951959991506659*^9, 
  3.951959992850025*^9}},ExpressionUUID->"0e99c267-53dd-4654-a16a-\
e7cc82b19a98"],

Cell["\<\
Na kvizu je skupno mo\[ZHacek]no dose\[CHacek]i 20 to\[CHacek]k. Za vsako \
pravilno re\[SHacek]eno podnalogo dobite 1 to\[CHacek]ko. Delnih to\[CHacek]k \
ni.\[LineSeparator]Re\[SHacek]itve pi\[SHacek]ite takoj pod navodilom \
ustrezne podnaloge. 

Veliko uspeha pri re\[SHacek]evanju!\
\>", "Text",
 CellChangeTimes->{{3.951960710901863*^9, 
  3.951960907701926*^9}},ExpressionUUID->"df4e5125-8d04-4670-8307-\
7fc238feadbb"],

Cell[CellGroupData[{

Cell["1. Prepisovalna pravila", "Subsubsection",
 CellChangeTimes->{{3.95114298550598*^9, 3.951142991673377*^9}, {
  3.95114330628814*^9, 3.951143309392208*^9}, {3.951960936392411*^9, 
  3.9519609364423857`*^9}},ExpressionUUID->"2d833155-8b3e-42e9-888a-\
8a5ce43fc396"],

Cell["\<\
a. Definirajte prepisovalno pravilo, ki  v izrazu vse pojavitve x zamenja s \
klicem funkcije f na argumentu x. \
\>", "Text",
 CellChangeTimes->{{3.951143315094033*^9, 3.951143319887273*^9}, {
  3.951143706281538*^9, 3.95114372972429*^9}, {3.951143787644503*^9, 
  3.951143804196362*^9}, {3.951961035868363*^9, 3.951961043241603*^9}, {
  3.9519614369686737`*^9, 3.95196148255293*^9}, {3.95196154613033*^9, 
  3.951961559726592*^9}},ExpressionUUID->"151e67a3-e0f9-4b8f-b87e-\
8b77535e2405"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"prepis", " ", "=", 
    RowBox[{"{", "  ", 
     RowBox[{"x", "->", 
      RowBox[{"f", "[", "x", "]"}]}], "}"}]}], " ", ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"imamo", " ", "x", " ", "in"}], " ", "/.", " ", 
    RowBox[{"prepi\[SHacek]e", " ", "x", " ", "v", " ", 
     RowBox[{"f", "[", "x", "]"}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9520680767391033`*^9, 3.952068170192007*^9}, {
   3.9520682053837757`*^9, 3.952068281621603*^9}, {3.9520686894376793`*^9, 
   3.952068691407881*^9}, {3.9520688094952145`*^9, 3.952068827064041*^9}, 
   3.952068887555956*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"0b5d8161-ce54-2b4f-98d7-79bee1c87c76"],

Cell[TextData[{
 "b. Na izrazu `izraz` najprej uporabite pravilo definirano v \
prej\[SHacek]nji nalogi za funkcijo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "4"], "+", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "f(x)=x^4+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "094c4d5b-e058-4a9c-b074-441b9c1a7ae3"],
 ", nato pa s prepisovalnimi pravili izra\[CHacek]unajte vrednost dobljenega \
izraza za x = e (x = \[ExponentialE]) in y = 1/2."
}], "Text",
 CellChangeTimes->{{3.951143808935487*^9, 3.951143845874085*^9}, {
   3.9519616862382927`*^9, 3.951961697032127*^9}, {3.951961736847426*^9, 
   3.951961788684046*^9}, {3.951961852511155*^9, 3.951961934828229*^9}, 
   3.951962135910755*^9},ExpressionUUID->"fb8d970c-943a-4303-bce1-\
a9029c907edb"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"x", "^", "4"}], "+", "1"}]}]}]], "Input",
 CellChangeTimes->{{3.952068396264797*^9, 3.9520684146319675`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"c3eb1a4a-8564-b343-8a83-6738f1867ce9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"izraz", " ", "=", " ", 
   RowBox[{
    RowBox[{"Log", "[", "x", "]"}], " ", "+", " ", 
    RowBox[{"2", 
     RowBox[{"y", " ", "/", " ", "x"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9519617005410147`*^9, 3.9519617170553093`*^9}, 
   3.9519627692620707`*^9, {3.9520684638043785`*^9, 3.9520684701488476`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"1845f3f8-c7c3-4bb5-b6cf-d71612a2aed3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"izraz", " ", "/.", "prepis"}]], "Input",
 CellChangeTimes->{{3.9520684717945404`*^9, 3.95206848111598*^9}, {
  3.9520687078846684`*^9, 3.952068708931984*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"815e386b-786b-6141-b66d-c0d9a37e7238"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"2", " ", "y"}], 
   RowBox[{"1", "+", 
    SuperscriptBox["x", "4"]}]], "+", 
  RowBox[{"Log", "[", 
   RowBox[{"1", "+", 
    SuperscriptBox["x", "4"]}], "]"}]}]], "Output",
 CellChangeTimes->{
  3.9520684817565117`*^9, {3.95206870943186*^9, 3.9520687147689114`*^9}, 
   3.952068832493805*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"966b9570-e262-e340-b82b-bbe03c598ca6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"izraz", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "->", "E"}], ",", 
    RowBox[{"y", "->", 
     RowBox[{"1", "/", "2"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.952068488264843*^9, 3.952068519800501*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"b504152b-4de5-864c-9bea-5ee205b47ac9"],

Cell[BoxData[
 RowBox[{"1", "+", 
  FractionBox["1", "\[ExponentialE]"]}]], "Output",
 CellChangeTimes->{{3.9520685090514565`*^9, 3.9520685203949547`*^9}, 
   3.9520688348873653`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"ff0f003b-27db-844e-bc18-8669afb75d32"]
}, Open  ]],

Cell[TextData[{
 "c. Definirajte prepisovalno pravilo, ki zamenja vse pojavitve ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7377295-348c-4eef-97f1-73409ac6f0dd"],
 " z ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        SuperscriptBox[
         StyleBox["x", "TI"], 
         RowBox[{
           StyleBox["n", "TI"], "+", "1"}]], 
        RowBox[{"2", 
          StyleBox["n", "TI"], "+", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{x^{n+1}}{2n + 1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54b0fef0-f7ec-4b56-ac3a-862571a4695b"],
 ". "
}], "Text",
 CellChangeTimes->{{3.951143853675414*^9, 3.951143853932055*^9}, {
