50ea02c7f849"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"odvod2", " ", "=", " ", 
   RowBox[{"D", "[", 
    RowBox[{"odvod", ",", "x"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9520726960245132`*^9, 3.952072704691889*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"82d9712f-7061-5444-8b42-434100dd7934"],

Cell[BoxData[
 RowBox[{
  RowBox[{"10", " ", 
   SuperscriptBox["\[ExponentialE]", "x"]}], "+", 
  RowBox[{"20", " ", 
   SuperscriptBox["\[ExponentialE]", "x"], " ", "x"}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["\[ExponentialE]", "x"], " ", 
   SuperscriptBox["x", "2"]}]}]], "Output",
 CellChangeTimes->{3.952072705098881*^9},
 CellLabel->
  "Out[170]=",ExpressionUUID->"233df081-8b9d-4546-8cbc-b7978b3a376a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{"odvod2", " ", ">=", " ", "0"}], ",", " ", "x"}], "]"}], " ", 
  RowBox[{"(*", " ", "konveksno", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{"odvod2", " ", "<=", " ", "0"}], ",", " ", "x"}], "]"}], " ", 
  RowBox[{"(*", " ", "konkavno", " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.952072708702429*^9, 3.9520727156604424`*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"4e641c4f-a9bf-b94e-b00e-e21ef91d88a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "\[LessEqual]", 
   RowBox[{
    RowBox[{"-", "2"}], "-", 
    SqrtBox["2"]}]}], "||", 
  RowBox[{"x", "\[GreaterEqual]", 
   RowBox[{
    RowBox[{"-", "2"}], "+", 
    SqrtBox["2"]}]}]}]], "Output",
 CellChangeTimes->{3.9520727160665703`*^9},
 CellLabel->
  "Out[171]=",ExpressionUUID->"26dc2b68-be1d-054f-b337-7962f1e916da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], "-", 
   SqrtBox["2"]}], "\[LessEqual]", "x", "\[LessEqual]", 
  RowBox[{
   RowBox[{"-", "2"}], "+", 
   SqrtBox["2"]}]}]], "Output",
 CellChangeTimes->{3.9520727160665703`*^9},
 CellLabel->
  "Out[172]=",ExpressionUUID->"5a71ef3d-8cb7-9d45-88f3-d105fc9aba24"]
}, Open  ]],

Cell[TextData[{
 "j. Na 3 decimalke natan\[CHacek]no izra\[CHacek]unajte volumen vrtenine , \
ki jo dobimo, \[CHacek]e graf funkcije ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1994bc17-ad61-4978-ae77-2c7559c84ea0"],
