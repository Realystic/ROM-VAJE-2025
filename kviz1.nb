   SuperscriptBox["\[ExponentialE]", "x"], " ", "x"}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["\[ExponentialE]", "x"], " ", 
   SuperscriptBox["x", "2"]}]}]], "Output",
 CellChangeTimes->{{3.9520723610487576`*^9, 3.9520724426657677`*^9}, 
   3.9520725372489223`*^9},
 CellLabel->
  "Out[165]=",ExpressionUUID->"de2c8cb2-b65f-8e46-bbac-a52425cd62c6"]
}, Open  ]],

Cell[TextData[{
 "f. Izra\[CHacek]unajte lokalne ekstreme funkcije ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
