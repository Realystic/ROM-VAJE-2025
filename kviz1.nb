Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#", ",", " ", 
      RowBox[{"f", "[", "#", "]"}]}], "}"}], "&"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"odvod", " ", "==", " ", "0"}], ",", " ", "x"}], "]"}], " ", "//",
      " ", "Flatten"}], " ", "//", " ", "Values"}]}], "]"}]], "Input",
