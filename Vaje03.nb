  3.920001056370714*^9}},ExpressionUUID->"d09306df-7e16-4e4f-8970-\
02df229e94e1"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"nakljucnaStevila", "[", "n_", "]"}], ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomInteger", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "100"}], ",", "100"}], "}"}], "]"}], ",", "n"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9502549390148697`*^9, 3.95025503792461*^9}},
