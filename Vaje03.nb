  3.950254787698889*^9}},ExpressionUUID->"f1e0cfbd-acf5-4bb7-9ea9-\
c95a6e8e3c22"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"->", " ", 
    RowBox[{
    "pomeni", " ", "da", " ", "\[CHacek]e", " ", "je", " ", "dobi", " ", 
     "kaj", " ", "v", " ", "obliki"}]}], ",", " ", 
   RowBox[{
   "ki", " ", "je", " ", "na", " ", "levi", " ", "strani", " ", 
    "pu\[SHacek]\[CHacek]ice", " ", "jo", " ", "spremeni", " ", "v", " ", 
    "obliko", " ", "na", " ", "desni", " ", "strani", " ", 
    "pu\[SHacek]\[CHacek]ice"}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.9502547895289555`*^9, 3.9502548234513817`*^9}, {
  3.9502548639710865`*^9, 
  3.950254926906*^9}},ExpressionUUID->"ae68ee69-5616-834c-b246-5434bb19e3cf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prepisPravilo", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a_", "*", 
      RowBox[{"(", 
       RowBox[{"b_", "+", "c_"}], ")"}]}], ":>", " ", 
     RowBox[{
      RowBox[{"a", "*", "b"}], "+", 
      RowBox[{"a", "*", "c"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", "x"}], "-", "4"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"3", "-", 
     RowBox[{"4", "y"}]}], ")"}]}], "//.", "prepisPravilo"}]}], "Input",
 CellChangeTimes->{{3.950254000993889*^9, 3.95025413677388*^9}, {
  3.9502545353132877`*^9, 3.9502547066609383`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"f994c9b9-f26f-0a40-b934-081040a2990b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "12"}], "+", 
  RowBox[{"6", " ", "x"}], "+", 
  RowBox[{"16", " ", "y"}], "-", 
  RowBox[{"8", " ", "x", " ", "y"}]}]], "Output",
 CellChangeTimes->{{3.950254683779911*^9, 3.9502547124025803`*^9}},
 CellLabel->"Out[19]=",ExpressionUUID->"651dc402-b224-ff47-ae7b-08614ccf7bff"]
}, Open  ]],

