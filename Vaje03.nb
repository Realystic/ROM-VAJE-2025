Cell["\<\
Napi\[SHacek]i  funkcijo quickSort, ki sprejme seznam in vrne urejen seznam. \
Za urejanje naj uporabi algoritem quick sort\
\>", "Text",
 CellChangeTimes->{{3.919321974718964*^9, 
  3.919322032589476*^9}},ExpressionUUID->"90c84ab9-ce97-483d-ade2-\
613fa46deddc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuickSort", "[", "sez_", "]"}], " ", ":=", "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "sez", "]"}], "<=", "1"}], ",", " ", "sez", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sezManjse", ",", " ", "sezEnako", ",", " ", "sezVecje"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sezManjse", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"sez", ",", " ", 
          RowBox[{
           RowBox[{"#", "<", 
            RowBox[{"First", "[", "sez", "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sezEnako", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"sez", ",", " ", 
          RowBox[{
           RowBox[{"#", "==", 
            RowBox[{"First", "[", "sez", "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sezVecje", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"sez", ",", " ", 
          RowBox[{
           RowBox[{"#", ">", 
            RowBox[{"First", "[", "sez", "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"QuickSort", "[", "sezManjse", "]"}], ",", " ", "sezEnako", 
         ",", " ", 
         RowBox[{"QuickSort", "[", "sezVecje", "]"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 CellChangeTimes->{{3.9502528716674232`*^9, 3.950252910798132*^9}, {
   3.9502529420073833`*^9, 3.9502529538729076`*^9}, {3.9502530256359615`*^9, 
   3.9502530438303547`*^9}, {3.9502531436808968`*^9, 
   3.9502531628603706`*^9}, {3.9502531948572216`*^9, 3.950253344565113*^9}, {
   3.950253413637953*^9, 3.9502534206584663`*^9}, {3.950253490511633*^9, 
   3.9502536923611736`*^9}, 3.9502537389691906`*^9},
