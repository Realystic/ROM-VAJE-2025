Cell[CellGroupData[{

Cell["Naloga  4", "Section",
 CellChangeTimes->{{3.919342200345504*^9, 3.9193422034770727`*^9}, {
  3.919996388454933*^9, 3.919996388623172*^9}, {3.919999357018867*^9, 
