              StyleBox["a", "TI"], 
              StyleBox["n", "TI"]], "+", "6"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a_{n+1} = \\frac{1}{6}(a_n^2 + a_n + 6)", 
